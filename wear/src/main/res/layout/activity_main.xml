<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="30dp"
        android:paddingEnd="20dp"
        android:paddingBottom="56dp">

        <TextView
            android:id="@+id/phaseText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:textColor="#FFFFFF"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/sessionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8A90"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/stopBtn"
                style="@style/RoundButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/stop"
                android:src="@drawable/ic_stop" />

            <ImageButton
                android:id="@+id/startBtn"
                style="@style/RoundButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="@string/start"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/skipBtn"
                style="@style/RoundButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/skip"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <TextView
            android:id="@+id/workTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/work"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/workMinus"
                style="@style/RoundButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="−" />

            <TextView
                android:id="@+id/workMinutes"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <Button
                android:id="@+id/workPlus"
                style="@style/RoundButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="+" />
        </LinearLayout>

        <TextView
            android:id="@+id/breakTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/brk"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/breakMinus"
                style="@style/RoundButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="−" />

            <TextView
                android:id="@+id/breakMinutes"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <Button
                android:id="@+id/breakPlus"
                style="@style/RoundButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="+" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
